        <mxCell id="n33" value="&lt;b&gt;Return traffic:&lt;/b&gt; replies use the same client connection. The campus connector asks for decisions; AWS does not open a new connection to the gate." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="960" width="795" height="100" />
        </mxCell>
        <mxCell id="n34" value="&lt;b&gt;Pilot limits:&lt;/b&gt; one EC2 and one RDS instance are not highly available. Use a domain and a trusted TLS certificate on EC2. See page 2 for passwords, permissions and monitoring." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="960" width="795" height="100" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
