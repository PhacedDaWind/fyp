        <mxCell id="n24" value="Save images" edge="1" parent="1" source="n11" target="n19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2878A6;fontColor=#2878A6;fontFamily=Helvetica;fontSize=13;labelBackgroundColor=#FFFFFF;">
