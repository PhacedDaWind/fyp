            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n25" value="Never give database passwords to the browser or camera. The app reads the secret using its instance role." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="200" width="260" height="120" />
        </mxCell>
        <mxCell id="n26" value="Install / configure the CloudWatch agent or app log shipping. Alerts do not appear automatically." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="400" width="260" height="120" />
        </mxCell>
        <mxCell id="n27" value="Install the SSM agent and allow outbound HTTPS. No inbound port 22 is needed." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="600" width="260" height="110" />
        </mxCell>
        <mxCell id="n28" value="Only retain images if approved. Use private access, encryption and a deletion policy." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="800" width="260" height="110" />
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;RDS backups + encryption&lt;/b&gt;&lt;br&gt;Enable automatic backups and encryption.&lt;br&gt;Secrets Manager and RDS use KMS encryption.&lt;br&gt;A separate custom KMS key is optional." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#23394D;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="105" y="780" width="710" height="110" />
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;Not required for this pilot:&lt;/b&gt; NAT Gateway or private VPC endpoints (EC2 already has public outbound access). A load balancer + ACM certificate, private EC2 subnets, or Multi-AZ failover are later upgrades with extra design and cost." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1040" width="1500" height="80" />
        </mxCell>
      </root>
