          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="n23" value="No permit, payment, blocked-status or guest-approval check at exit.&lt;br&gt;The entry lookup is only for calculating duration and finding the visit to update." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="410" width="360" height="185" />
        </mxCell>
        <mxCell id="n24" value="No matching entry?&lt;br&gt;Show “Duration unavailable” and still open the gate.&lt;br&gt;After passage, save the plate and exit time as an unmatched EXITED record." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="440" width="390" height="195" />
        </mxCell>
        <mxCell id="n25" value="Plate unreadable or system unavailable?&lt;br&gt;Guard helps with the plate / manual exit.&lt;br&gt;Record confirmed exit when the system is available." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="750" width="360" height="175" />
        </mxCell>
        <mxCell id="n26" value="Guests and registered vehicles follow the same exit steps. Final duration = confirmed exit time minus entry time. Repeated passage reports must not save duplicate exits." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#23394D;rounded=0;fillColor=#FFF7DF;strokeColor=#78909C;spacing=10;" vertex="1" parent="1">
